# Fitness OS — Supabase configuration
#
# Copy this file to .env.local and fill in the values from your OWN
# dedicated Fitness OS Supabase project (Project Settings -> API).
#
# This must be a Fitness OS-only Supabase project — never reuse the
# APFC-TRACKER project, database, or credentials here.
#
# Only the browser-safe project URL and the publishable/anonymous key
# belong here. Both are safe to expose to the client: the anonymous key
# has no access beyond what Row Level Security policies explicitly grant.
#
# NEVER put the service_role key, database password, or any other
# server-only secret in a VITE_* variable — anything prefixed VITE_ is
# bundled into the client JavaScript and is publicly visible.
#
# When these are left unset, Fitness OS runs fully local-first: no
# Supabase client is created, authentication is skipped, and all
# existing local stores keep working exactly as before.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
